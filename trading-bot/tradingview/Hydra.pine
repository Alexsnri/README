//@version=6
// Hydra: espejo para TradingView del EA de MT5 (trading-bot/mt5/Hydra.mq5).
// Misma lógica: D = Breakout Donchian 55/20, T = Momentum 4 horizontes, M = RSI(2) de Connors.
// Úsalo en gráfico DIARIO (1D). Muestra entradas, salidas y stops y lo puedes correr en el Probador de estrategias.
// Nota: TradingView suma todas las posiciones del símbolo en una sola (no hay cobertura), así que una
// venta cierra las compras abiertas. En MT5 cada estrategia lleva su propia posición.
strategy("Hydra", overlay = true, pyramiding = 3, initial_capital = 5000,
     commission_type = strategy.commission.percent, commission_value = 0.01, slippage = 2,
     margin_long = 3, margin_short = 3)

riskPct = input.float(4.0, "Riesgo % por trade (Turbo=4, Reto=3, Normal=1, Conservador=0.5)", minval = 0.1, step = 0.1)
goal    = input.float(1000000, "Meta")
useD    = input.bool(true, "D: Breakout Donchian")
useT    = input.bool(true, "T: Momentum")
useM    = input.bool(true, "M: RSI(2)")
clsIn   = input.string("Auto", "Tipo de activo", options = ["Auto", "Forex", "Metal", "Índice", "Energía", "Cripto"])

// ---------- clase de activo
string tk = syminfo.ticker
bool autoMetal = str.startswith(tk, "XAU") or str.startswith(tk, "XAG")
bool autoIndex = syminfo.type == "index" or (syminfo.type == "cfd" and not autoMetal and not str.contains(tk, "OIL"))
bool isMetal = clsIn == "Metal" or (clsIn == "Auto" and autoMetal)
bool isIndex = clsIn == "Índice" or (clsIn == "Auto" and autoIndex)
bool canShort = not isIndex

// ---------- indicadores (idénticos al EA y al backtest)
float atr    = ta.rma(ta.tr(true), 20)
float dcHi   = ta.highest(high, 55)[1]
float dcLo   = ta.lowest(low, 55)[1]
float exHi   = ta.highest(high, 20)[1]
float exLo   = ta.lowest(low, 20)[1]
float ema50  = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float sma200 = ta.sma(close, 200)
float sma5   = ta.sma(close, 5)
float rsi2   = ta.rsi(close, 2)
float mom    = (math.sign(close / close[21] - 1) + math.sign(close / close[63] - 1) +
               math.sign(close / close[126] - 1) + math.sign(close / close[252] - 1)) / 4

isOpen(string id) =>
    bool found = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                found := true
    found

qtyFor(float dist) =>
    float q = strategy.equity * riskPct / 100 / (dist * syminfo.pointvalue)
    math.max(q, 0)

var float sDL = na
var float sDS = na
var float sTL = na
var float sTS = na
var float sML = na
var int   mlBars = 0
bool ready = bar_index > 260 and not na(atr)

if ready
    // ===== D: Breakout Donchian
    if isOpen("D-L")
        if close < exLo
            strategy.close("D-L", comment = "D salida canal")
        else
            sDL := math.max(sDL, close - 2.5 * atr)
    else if useD and close > dcHi and ema50 > ema200
        sDL := close - 2.5 * atr
        strategy.entry("D-L", strategy.long, qty = qtyFor(2.5 * atr), comment = "D compra")
    if isOpen("D-S")
        if close > exHi
            strategy.close("D-S", comment = "D salida canal")
        else
            sDS := math.min(sDS, close + 2.5 * atr)
    else if useD and canShort and close < dcLo and ema50 < ema200
        sDS := close + 2.5 * atr
        strategy.entry("D-S", strategy.short, qty = qtyFor(2.5 * atr), comment = "D venta")

    // ===== T: Momentum
    if isOpen("T-L")
        if mom <= 0
            strategy.close("T-L", comment = "T momentum perdido")
        else
            sTL := math.max(sTL, close - 3 * atr)
    else if useT and mom >= 0.75 and close > ema50
        sTL := close - 3 * atr
        strategy.entry("T-L", strategy.long, qty = qtyFor(3 * atr), comment = "T compra")
    if isOpen("T-S")
        if mom >= 0
            strategy.close("T-S", comment = "T momentum perdido")
        else
            sTS := math.min(sTS, close + 3 * atr)
    else if useT and canShort and mom <= -0.75 and close < ema50
        sTS := close + 3 * atr
        strategy.entry("T-S", strategy.short, qty = qtyFor(3 * atr), comment = "T venta")

    // ===== M: RSI(2) (sólo índices y metales, sólo compras)
    if isOpen("M-L")
        mlBars += 1
        if close > sma5 or mlBars >= 10
            strategy.close("M-L", comment = "M rebote")
    else if useM and (isIndex or isMetal) and close > sma200 and rsi2 < 10
        sML := close - 2.5 * atr
        mlBars := 0
        strategy.entry("M-L", strategy.long, qty = qtyFor(2.5 * atr), comment = "M compra")

strategy.exit("xD-L", from_entry = "D-L", stop = sDL, comment = "D stop")
strategy.exit("xD-S", from_entry = "D-S", stop = sDS, comment = "D stop")
strategy.exit("xT-L", from_entry = "T-L", stop = sTL, comment = "T stop")
strategy.exit("xT-S", from_entry = "T-S", stop = sTS, comment = "T stop")
strategy.exit("xM-L", from_entry = "M-L", stop = sML, comment = "M stop")

// ---------- visual
plot(dcHi, "Donchian 55 alto", color.new(color.teal, 40))
plot(dcLo, "Donchian 55 bajo", color.new(color.teal, 40))
plot(ema50, "EMA 50", color.new(color.orange, 0))
plot(ema200, "EMA 200", color.new(color.purple, 0), 2)
plot(isOpen("D-L") ? sDL : isOpen("T-L") ? sTL : na, "Stop compras", color.green, 1, plot.style_linebr)
plot(isOpen("D-S") ? sDS : isOpen("T-S") ? sTS : na, "Stop ventas", color.red, 1, plot.style_linebr)
bgcolor(mom >= 0.75 ? color.new(color.green, 92) : mom <= -0.75 ? color.new(color.red, 92) : na, title = "Régimen de momentum")

var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    float eq = strategy.equity
    float prog = eq > strategy.initial_capital ? math.log(eq / strategy.initial_capital) / math.log(goal / strategy.initial_capital) * 100 : 0
    table.cell(panel, 0, 0, "HYDRA", text_color = color.white)
    table.cell(panel, 1, 0, str.tostring(riskPct) + "% / trade", text_color = color.white)
    table.cell(panel, 0, 1, "Capital", text_color = color.white)
    table.cell(panel, 1, 1, str.tostring(eq, format.mintick), text_color = color.white)
    table.cell(panel, 0, 2, "Progreso a meta (log)", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(prog, "#.0") + "%", text_color = color.white)
    table.cell(panel, 0, 3, "Momentum", text_color = color.white)
    table.cell(panel, 1, 3, str.tostring(mom, "#.##"), text_color = mom > 0 ? color.lime : color.red)
