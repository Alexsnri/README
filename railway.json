{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scalper/Dockerfile.railway",
    "watchPatterns": ["scalper/bot/**", "scalper/config.yaml", "scalper/requirements.txt", "scalper/Dockerfile.railway"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
