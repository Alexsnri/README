# Copia este archivo como .env (solo si corres el bot en un VPS). En Railway estas variables van en "Variables".
# NUNCA subas tu .env a GitHub (ya está en .gitignore).
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=          # el correo con el que entras a Capital.com
CAPITAL_API_PASSWORD=        # la contraseña personalizada que pusiste al crear la API key
TELEGRAM_TOKEN=              # el token que te da @BotFather
DASHBOARD_PASSWORD=          # la contraseña con la que vas a entrar al dashboard
# TELEGRAM_CHAT_ID=          # opcional: si no lo pones, manda /vincular CODIGO a tu bot
# CAPITAL_API_URL solo puede ser la demo; si pones otra, el bot se niega a arrancar.
